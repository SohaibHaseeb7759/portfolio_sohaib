---
import ProjectFrame from "./ProjectFrame.astro";
import ProjectLinks from "./ProjectLinks.astro";
import { projects, sections } from "../data/site";

const copy = sections.work;

const pad = (n: number) => String(n).padStart(2, "0");
const numbered = projects.map((p, i) => ({ p, n: pad(i + 1) }));
const features = numbered.filter(({ p }) => p.layout === "feature");
// Every other project is a card with an architecture diagram, in data order.
const cards = numbered.filter(({ p }) => p.layout === "text");
---

<section class="section work" id="work" aria-labelledby="work-title">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow"><b>{copy.n}</b> {copy.label}</p>
      <h2 id="work-title" data-reveal>{copy.title}</h2>
      <p data-reveal>{copy.intro}</p>
    </header>

    {features.map(({ p, n }) => (
      <article class="project feature" aria-labelledby={`p-${p.slug}`}>
        <div class="feature__media" data-reveal>
          <ProjectFrame project={p} sizes="(min-width: 1100px) 720px, (min-width: 860px) 58vw, 100vw" />
        </div>

        <div class="feature__body" data-reveal style="--reveal-i:1">
          <p class="project__meta mono">
            <span class="project__n">{n}</span>
            <span>{p.kind}</span>
            {p.date && <span class="project__date">{p.date}</span>}
          </p>
          <h3 class="feature__title" id={`p-${p.slug}`}>{p.title}</h3>
          <p class="feature__summary">{p.summary}</p>

          <dl class="feature__detail">
            {p.problem && (
              <div>
                <dt class="mono">Problem</dt>
                <dd>{p.problem}</dd>
              </div>
            )}
            <div>
              <dt class="mono">What I built</dt>
              <dd>
                <ul role="list" class="built">
                  {p.built.map((b) => <li>{b}</li>)}
                </ul>
              </dd>
            </div>
          </dl>

          <ul class="tags" role="list" aria-label="Technologies">
            {p.stack.map((s) => <li>{s}</li>)}
          </ul>

          <ProjectLinks project={p} stretch />
        </div>
      </article>
    ))}

    <div class="cards">
      {cards.map(({ p, n }, i) => (
        <article
          class:list={["project card", { "is-linked": p.live || p.repo }]}
          aria-labelledby={`p-${p.slug}`}
          data-reveal
          style={`--reveal-i:${i % 3}`}
        >
          {p.flow && (
            <div class="card__cover">
              <span class="card__cover-label mono" aria-hidden="true">Architecture</span>
              <ol class="flow" role="list" aria-label={`${p.title} architecture`}>
                {p.flow.map((node) => <li class="flow__node mono">{node}</li>)}
              </ol>
            </div>
          )}

          <div class="card__body">
            <p class="project__meta mono">
              <span class="project__n">{n}</span>
              <span class="card__kind">{p.kind}</span>
            </p>
            <h3 class="card__title" id={`p-${p.slug}`}>{p.title}</h3>
            {p.date && <p class="card__date mono">{p.date}</p>}
            <p class="card__summary">{p.summary}</p>
            <ul role="list" class="built card__built">
              {p.built.map((b) => <li>{b}</li>)}
            </ul>
            <ul class="tags card__tags" role="list" aria-label="Technologies">
              {p.stack.map((s) => <li>{s}</li>)}
            </ul>
            {(p.live || p.repo) && <ProjectLinks project={p} stretch />}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .work {
    border-top: 1px solid var(--c-border);
  }

  .project__meta {
    display: flex;
    gap: var(--s-3);
    color: var(--c-text-3);
    margin-bottom: var(--s-3);
  }

  .project__n {
    flex: none;
    color: var(--c-blue);
  }

  .project__date::before {
    content: "·";
    margin-right: var(--s-3);
  }

  .built {
    display: grid;
    gap: var(--s-1);
  }

  .built li {
    position: relative;
    padding-left: 1.1em;
  }

  .built li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.5em;
    height: 1px;
    background: var(--c-text-3);
  }

  /* ---------- Lead feature ---------- */
  .feature {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--s-6) var(--s-5);
    align-items: center;
    margin-bottom: var(--s-8);
  }

  .feature__media {
    grid-column: 1 / span 7;
    position: relative;
  }

  /* Soft colored light behind the stage */
  .feature__media::before {
    content: "";
    position: absolute;
    inset: 12% 8% -6%;
    z-index: -1;
    background: radial-gradient(closest-side, var(--c-blue-glow), transparent);
    filter: blur(30px);
  }

  .feature__body {
    grid-column: 8 / -1;
    max-width: 52ch;
  }

  .feature__title {
    font-size: var(--t-2xl);
    letter-spacing: -0.04em;
    margin-bottom: var(--s-4);
  }

  .feature__summary {
    font-size: var(--t-md);
    line-height: 1.5;
    color: var(--c-text);
    margin-bottom: var(--s-5);
  }

  .feature__detail {
    display: grid;
    gap: var(--s-4);
    margin-bottom: var(--s-5);
    padding-top: var(--s-4);
    border-top: 1px solid var(--c-border);
  }

  .feature__detail dt {
    color: var(--c-blue);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--s-1);
  }

  .feature__detail dd {
    font-size: var(--t-sm);
    color: var(--c-text-2);
  }

  .feature .tags {
    margin-bottom: var(--s-5);
  }

  /* ---------- Card grid ---------- */
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-5);
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    background: var(--c-surface-1);
    overflow: hidden;
    transition:
      border-color var(--d-base) var(--ease-out),
      box-shadow var(--d-base) var(--ease-out),
      transform var(--d-base) var(--ease-out);
  }

  .card.is-linked:hover {
    border-color: var(--c-rose-line);
    box-shadow: var(--shadow-2);
  }

  @media (prefers-reduced-motion: no-preference) {
    .card.is-linked:hover {
      transform: translateY(-2px);
    }
  }

  .card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--s-5);
  }

  .card__kind {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .card__title {
    font-size: var(--t-lg);
    letter-spacing: -0.03em;
    margin-bottom: var(--s-2);
  }

  .card__date {
    color: var(--c-text-3);
    margin-bottom: var(--s-3);
  }

  .card__summary {
    font-size: var(--t-sm);
    color: var(--c-text);
    margin-bottom: var(--s-4);
  }

  .card__built {
    font-size: var(--t-sm);
    color: var(--c-text-2);
    margin-bottom: var(--s-4);
  }

  /* Tags and link sit on the card's floor so rows line up */
  .card__tags {
    margin-top: auto;
  }

  .card__tags:not(:last-child) {
    margin-bottom: var(--s-4);
  }

  /* ---------- Architecture cover ---------- */
  .card__cover {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 140px;
    padding: var(--s-6) var(--s-4) var(--s-4);
    border-bottom: 1px solid var(--c-border);
    background:
      radial-gradient(70% 90% at 50% 0%, var(--c-blue-glow), transparent 70%),
      linear-gradient(to right, var(--c-grid-line) 1px, transparent 1px) 0 0 / 28px 28px,
      linear-gradient(to bottom, var(--c-grid-line) 1px, transparent 1px) 0 0 / 28px 28px,
      var(--c-surface-2);
  }

  /* Alternate the cover light so the grid has a blue / rose rhythm */
  .card:nth-child(even) .card__cover {
    background:
      radial-gradient(70% 90% at 50% 0%, var(--c-rose-glow), transparent 70%),
      linear-gradient(to right, var(--c-grid-line) 1px, transparent 1px) 0 0 / 28px 28px,
      linear-gradient(to bottom, var(--c-grid-line) 1px, transparent 1px) 0 0 / 28px 28px,
      var(--c-surface-2);
  }

  .card__cover-label {
    position: absolute;
    top: var(--s-3);
    left: var(--s-4);
    color: var(--c-text-3);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* Request path drawn as connected nodes; wraps instead of overflowing */
  .flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--s-3) 0;
  }

  .flow__node {
    position: relative;
    padding: 6px 10px;
    border: 1px solid var(--c-border-strong);
    border-radius: var(--r-sm);
    background: var(--c-bg);
    color: var(--c-text);
    font-size: 0.7rem;
    white-space: nowrap;
  }

  .flow__node + .flow__node {
    margin-left: 22px;
  }

  /* Connector with arrowhead */
  .flow__node + .flow__node::before {
    content: "";
    position: absolute;
    right: 100%;
    top: 50%;
    width: 22px;
    height: 1px;
    background: linear-gradient(to right, var(--c-blue), var(--c-rose));
  }

  .flow__node + .flow__node::after {
    content: "";
    position: absolute;
    right: calc(100% + 1px);
    top: calc(50% - 3px);
    border: 3px solid transparent;
    border-left: 4px solid var(--c-rose);
    border-right: 0;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 1099px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 859px) {
    .feature__media,
    .feature__body {
      grid-column: 1 / -1;
    }

    .feature__body {
      max-width: none;
    }

    .cards {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-4);
    }
  }

  @media (max-width: 599px) {
    .card__body {
      padding: var(--s-4);
    }
  }
</style>
