---
import Icon from "./Icon.astro";
import type { Project } from "../data/site";

interface Props {
  project: Project;
  /**
   * Stretch the primary link over its card so the whole card is clickable.
   * The card must be `position: relative`; secondary links sit above the overlay.
   */
  stretch?: boolean;
}

const { project, stretch = false } = Astro.props;
const primary = project.live ? "live" : project.repo ? "repo" : null;
---

<div class="project-links">
  {project.live && (
    <a
      class:list={["btn btn--primary btn--sm", { stretched: stretch && primary === "live" }]}
      href={project.live}
      target="_blank"
      rel="noopener noreferrer"
    >
      Visit live site <span class="visually-hidden">for {project.title} (opens in a new tab)</span>
      <Icon name="arrow-ur" />
    </a>
  )}
  {project.repo && (
    <a
      class:list={[
        "btn btn--sm",
        { "btn--primary": !project.live, stretched: stretch && primary === "repo", above: stretch && primary !== "repo" },
      ]}
      href={project.repo}
      target="_blank"
      rel="noopener noreferrer"
    >
      <Icon name="github" /> View source <span class="visually-hidden">of {project.title} on GitHub (opens in a new tab)</span>
      <Icon name="arrow-ur" />
    </a>
  )}
  {project.sourcePrivate && !project.repo && <span class="private mono">Private repository</span>}
</div>

<style>
  .project-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
  }

  /* Covers the nearest positioned ancestor (the card) */
  .stretched::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }

  /* Draw the focus ring around the whole card the link now represents */
  .stretched:focus-visible::after {
    outline: 2px solid var(--c-blue);
    outline-offset: -3px;
    border-radius: var(--r-md);
  }

  .above {
    position: relative;
    z-index: 2;
  }

  .private {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--c-text-3);
    padding-inline: var(--s-2);
  }

  .private::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    border: 1px solid currentColor;
  }
</style>
