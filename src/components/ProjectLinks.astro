---
import Icon from "./Icon.astro";
import type { Project } from "../data/site";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<div class="project-links">
  {project.live && (
    <a class="btn btn--primary btn--sm" href={project.live} target="_blank" rel="noopener noreferrer">
      Visit live site <span class="visually-hidden">for {project.title} (opens in a new tab)</span>
      <Icon name="arrow-ur" />
    </a>
  )}
  {project.repo && (
    <a
      class:list={["btn btn--sm", { "btn--primary": !project.live }]}
      href={project.repo}
      target="_blank"
      rel="noopener noreferrer"
    >
      <Icon name="github" /> View source <span class="visually-hidden">of {project.title} on GitHub (opens in a new tab)</span>
      <Icon name="arrow-ur" />
    </a>
  )}
  {project.sourcePrivate && !project.repo && <span class="private mono">Private repository</span>}
</div>

<style>
  .project-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
  }

  .private {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--c-text-3);
    padding-inline: var(--s-2);
  }

  .private::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    border: 1px solid currentColor;
  }
</style>
