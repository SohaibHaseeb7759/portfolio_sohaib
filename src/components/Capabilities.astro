---
import { capabilities, sections, stack } from "../data/site";

const copy = sections.skills;
---

<section class="section caps" id="skills" aria-labelledby="caps-title">
  <div class="container">
    <header class="section-head section-head--compact">
      <p class="eyebrow"><b>{copy.n}</b> {copy.label}</p>
      <h2 id="caps-title" data-reveal>{copy.title}</h2>
      <p data-reveal>{copy.intro}</p>
    </header>

    <ol class="disciplines" role="list">
      {capabilities.map((c, i) => (
        <li class="discipline" data-reveal style={`--reveal-i:${i}`}>
          <span class="discipline__n mono">0{i + 1}</span>
          <h3 class="discipline__title">{c.title}</h3>
          <p class="discipline__summary">{c.summary}</p>
        </li>
      ))}
    </ol>

    <div class="stack" data-reveal>
      <h3 class="stack__title mono">{copy.toolkit}</h3>
      {stack.map((s) => (
        <div class="stack__row">
          <h4 class="stack__group-title mono">{s.group}</h4>
          <ul class="chips" role="list">
            {s.items.map((item) => <li class="chip">{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* ---------- Disciplines: three columns, accent always visible ---------- */
  .disciplines {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-6);
    margin-bottom: var(--s-8);
  }

  .discipline {
    position: relative;
    padding-top: var(--s-5);
    border-top: 1px solid var(--c-border);
  }

  /* A short gradient rule marks every row; on hover it runs the full width */
  .discipline::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    width: 48px;
    height: 2px;
    background: var(--g-signal);
    transition: width var(--d-slow) var(--ease-out);
  }

  .discipline:hover::before {
    width: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .discipline::before {
      transition: none;
    }
  }

  .discipline__n {
    display: block;
    color: var(--c-blue);
    margin-bottom: var(--s-3);
  }

  .discipline__title {
    font-size: var(--t-lg);
    font-weight: 500;
    letter-spacing: -0.03em;
    margin-bottom: var(--s-3);
  }

  .discipline__summary {
    color: var(--c-text-2);
    font-size: var(--t-sm);
    max-width: 46ch;
  }

  /* ---------- Toolkit: chip rows ---------- */
  .stack {
    border-top: 1px solid var(--c-border);
  }

  .stack__title {
    padding-block: var(--s-4);
    color: var(--c-text-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 500;
  }

  .stack__row {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: var(--s-5);
    align-items: baseline;
    padding-block: var(--s-4);
    border-top: 1px solid var(--c-border);
  }

  .stack__group-title {
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-text-2);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 0 var(--s-3);
    border: 1px solid var(--c-border);
    border-radius: var(--r-pill);
    background: var(--c-surface-2);
    color: var(--c-text);
    font-family: var(--f-mono);
    font-size: var(--t-sm);
    line-height: 1;
    white-space: nowrap;
  }

  @media (max-width: 1099px) {
    .disciplines {
      gap: var(--s-5);
    }
  }

  @media (max-width: 859px) {
    .disciplines {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-4);
    }

    .stack__row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-3);
    }
  }
</style>
