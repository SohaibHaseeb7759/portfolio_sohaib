---
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import portrait from "../assets/portrait.jpg";
import { experience, profile } from "../data/site";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// Ruler ticks down the left edge of the arch (viewBox units).
const ticks = Array.from({ length: 11 }, (_, i) => 216 + i * 28);
const current = experience.filter((r) => r.current);
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__grid-bg" aria-hidden="true"></div>

  <div class="hero__inner container">
    <div class="hero__copy">
      <p class="eyebrow hero__eyebrow anim" style="--i:0">
        <span class="hero__dot" aria-hidden="true"></span>
        {profile.role} <span aria-hidden="true">·</span> {profile.location}
      </p>

      <h1 class="hero__title" id="hero-title">
        <span class="line"><span class="anim" style="--i:1">Muhammad</span></span>
        <span class="line"><span class="anim" style="--i:2">Sohaib <em>Haseeb</em></span></span>
      </h1>

      <p class="hero__lede anim" style="--i:3">
        I build <span class="hl">production web applications</span> across the stack, from database and CMS design to
        fast, responsive UI.
      </p>

      <div class="hero__actions anim" style="--i:4">
        <a class="btn btn--primary" href="#work">View selected work <Icon name="arrow-d" /></a>
        <a class="btn" href={`${base}/${profile.cv}`} download={profile.cv}>
          Download CV <Icon name="arrow-d" />
        </a>
      </div>

      <ul class="hero__now anim" style="--i:5" role="list" aria-label="Current roles">
        {current.map((r) => (
          <li>
            <span class="hero__now-dot" aria-hidden="true"></span>
            <span class="hero__now-title">{r.title}</span>
            <span class="hero__now-at">at {r.company}</span>
          </li>
        ))}
      </ul>

      {profile.availability && (
        <p class="hero__open mono anim" style="--i:6">
          <span class="hero__now-dot hero__now-dot--rose" aria-hidden="true"></span>
          {profile.availability}
        </p>
      )}
    </div>

    <figure class="hero__figure anim anim--fig" style="--i:2">
      <div class="arch">
        <svg class="arch__svg" viewBox="0 0 400 500" aria-hidden="true">
          <defs>
            <linearGradient id="arc-grad" x1="0" y1="0" x2="1" y2="1">
              <stop class="stop-a" offset="0%" />
              <stop class="stop-b" offset="100%" />
            </linearGradient>
          </defs>
          <g class="arch__ticks">
            {ticks.map((y, i) => <line x1={i % 5 === 0 ? -16 : -11} y1={y} x2="-4" y2={y} class={i % 5 === 0 ? "major" : ""} />)}
          </g>
          <!-- Outline: up the left side, over a semicircle, down the right -->
          <path class="arch__ring" d="M1 500V200A199 199 0 0 1 399 200V500" />
          <path class="arch__arc" d="M1 500V200A199 199 0 0 1 399 200V500" pathLength="100" />
          <circle class="arch__node" cx="372.3" cy="100.5" r="4.5" />
        </svg>
        <div class="arch__photo">
          <Picture
            src={portrait}
            alt={`${profile.name} sitting outdoors in a denim jacket and sunglasses, in warm afternoon light`}
            formats={["avif", "webp"]}
            widths={[320, 480, 640, portrait.width]}
            sizes="(min-width: 1100px) 360px, (min-width: 860px) 30vw, min(70vw, 300px)"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
      <figcaption class="hero__caption mono">
        <span>Fig. 01 · {profile.shortName}</span>
        <span>{profile.coords}</span>
      </figcaption>
    </figure>

    <div class="hero__foot anim" style="--i:5">
      <p class="mono hero__foot-label">Stack</p>
      <ul class="hero__focus" role="list">
        {profile.focus.map((f) => <li>{f}</li>)}
      </ul>
      <a class="hero__scroll mono" href="#about">
        Scroll <Icon name="arrow-d" />
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(100svh, 980px);
    display: flex;
    align-items: center;
    padding-block: calc(var(--nav-h) + var(--s-7)) var(--s-6);
    isolation: isolate;
    overflow: hidden;
  }

  /* Blueprint grid + two restrained light sources */
  .hero__grid-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(40rem 30rem at 78% 42%, var(--c-blue-light), transparent 70%),
      radial-gradient(26rem 20rem at 92% 78%, var(--c-rose-light), transparent 70%),
      linear-gradient(to right, var(--c-grid-line) 1px, transparent 1px) 0 0 / 80px 80px,
      linear-gradient(to bottom, var(--c-grid-line) 1px, transparent 1px) 0 0 / 80px 80px;
    -webkit-mask-image: radial-gradient(ellipse 90% 80% at 60% 40%, #000 40%, transparent 100%);
    mask-image: radial-gradient(ellipse 90% 80% at 60% 40%, #000 40%, transparent 100%);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--s-5);
    row-gap: var(--s-7);
    align-items: center;
  }

  .hero__copy {
    grid-column: 1 / span 8;
  }

  .hero__eyebrow {
    margin-bottom: var(--s-5);
  }

  .hero__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--c-blue);
    box-shadow: 0 0 0 4px var(--c-blue-soft);
  }

  .hero__title {
    font-size: var(--t-hero);
    font-weight: 600;
    line-height: 0.94;
    letter-spacing: -0.045em;
    margin-bottom: var(--s-6);
  }

  .hero__title .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }

  .hero__title .line > span {
    display: inline-block;
  }

  .hero__title em {
    font-style: normal;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--c-text-2);
    text-shadow: 0 0 24px var(--c-blue-soft);
  }

  .hero__lede {
    font-family: var(--f-display);
    font-size: var(--t-lg);
    line-height: 1.35;
    letter-spacing: -0.012em;
    color: var(--c-text-2);
    max-width: 34ch;
    margin-bottom: var(--s-6);
  }

  /* Marker runs blue into rose; clone keeps the gradient whole on each wrapped line */
  .hl {
    color: var(--c-text);
    background: linear-gradient(90deg, var(--c-blue-highlight), var(--c-rose-highlight)) no-repeat 0 100% / 100% 38%;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  /* Current roles */
  .hero__now {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-6);
    margin-top: var(--s-6);
    font-size: var(--t-sm);
  }

  .hero__now li {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
  }

  .hero__now-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-blue);
    box-shadow: 0 0 0 3px var(--c-blue-soft);
  }

  .hero__now-title {
    color: var(--c-text);
    font-weight: 500;
  }

  .hero__now-at {
    color: var(--c-text-3);
  }

  .hero__now-dot--rose {
    background: var(--c-rose);
    box-shadow: 0 0 0 3px var(--c-rose-glow);
  }

  .hero__open {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin-top: var(--s-3);
    color: var(--c-text-2);
  }

  /* Portrait in an arched frame */
  .hero__figure {
    grid-column: 9 / -1;
    justify-self: end;
    width: 100%;
    max-width: 400px;
  }

  .arch {
    position: relative;
    aspect-ratio: 4 / 5;
  }

  .arch__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .arch__ticks line {
    stroke: var(--c-border-strong);
    stroke-width: 1;
  }

  .arch__ticks line.major {
    stroke: var(--c-text-3);
  }

  .arch__ring {
    fill: none;
    stroke: var(--c-border-strong);
    stroke-width: 1;
  }

  /* Gradient segment over the top-right of the arch, ending at the node */
  .arch__arc {
    fill: none;
    stroke: url(#arc-grad);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 17 100;
    stroke-dashoffset: -50;
  }

  .arch__node {
    fill: var(--c-rose);
  }

  .stop-a {
    stop-color: var(--c-blue-strong);
  }

  .stop-b {
    stop-color: var(--c-rose);
  }

  /* Inset 4.5% of the width on every side; top is 3.6% of the 5:4 height */
  .arch__photo {
    position: absolute;
    inset: 3.6% 4.5% 0;
    border-radius: 999px 999px var(--r-md) var(--r-md);
    overflow: hidden;
    background: var(--c-surface-2);
    box-shadow:
      0 0 0 1px var(--c-edge),
      0 40px 80px -30px var(--c-blue-shadow);
  }

  .arch__photo :global(picture) {
    height: 100%;
  }

  .arch__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Keeps the face in the round of the arch */
    object-position: 50% 53%;
    transition: transform 1.2s var(--ease-out);
  }

  /* Let the base of the photo settle into the page */
  .arch__photo::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 28%;
    background: linear-gradient(to top, var(--c-scrim-soft), transparent);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__figure:hover .arch__photo :global(img) {
      transform: scale(1.025);
    }
  }

  .hero__caption {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    margin-top: var(--s-4);
    padding-top: var(--s-3);
    border-top: 1px solid var(--c-border);
    color: var(--c-text-3);
  }

  /* Foot strip */
  .hero__foot {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: var(--s-5);
    padding-top: var(--s-5);
    border-top: 1px solid var(--c-border);
  }

  .hero__foot-label {
    color: var(--c-text-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .hero__focus {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    font-size: var(--t-sm);
    color: var(--c-text-2);
  }

  .hero__focus li + li::before {
    content: "";
    display: inline-block;
    width: 4px;
    height: 4px;
    margin-right: var(--s-5);
    vertical-align: middle;
    border-radius: 50%;
    background: var(--c-border-strong);
  }

  .hero__scroll {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-2) 0;
    color: var(--c-text-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    transition: color var(--d-fast);
  }

  .hero__scroll:hover {
    color: var(--c-text);
  }

  .hero__scroll :global(svg) {
    width: 14px;
    height: 14px;
  }

  /* Entrance choreography: one pass on load, nothing continuous */
  @media (prefers-reduced-motion: no-preference) {
    .anim {
      animation: rise 900ms var(--ease-out) both;
      animation-delay: calc(120ms + var(--i, 0) * 90ms);
    }

    .hero__title .anim {
      animation-name: line-up;
      animation-duration: 1000ms;
    }

    .anim--fig {
      animation-name: fade;
      animation-duration: 1200ms;
    }

    .arch__arc {
      animation: draw 1600ms var(--ease-out) 500ms both;
    }

    .arch__node {
      animation: fade 600ms ease 1700ms both;
    }

    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(16px);
      }
    }

    @keyframes line-up {
      from {
        transform: translateY(105%);
      }
    }

    @keyframes fade {
      from {
        opacity: 0;
      }
    }

    @keyframes draw {
      from {
        stroke-dasharray: 0 100;
      }
    }
  }

  /* Tablet */
  @media (max-width: 1099px) {
    .hero__copy {
      grid-column: 1 / span 7;
    }

    .hero__figure {
      grid-column: 8 / -1;
    }
  }

  /* Mobile: portrait leads, copy follows */
  @media (max-width: 859px) {
    .hero {
      min-height: auto;
      padding-top: calc(var(--nav-h) + var(--s-4));
    }

    .hero__inner {
      row-gap: var(--s-4);
    }

    .hero__copy,
    .hero__figure {
      grid-column: 1 / -1;
    }

    .hero__figure {
      order: -1;
      justify-self: center;
      width: min(70%, 300px);
      max-width: none;
    }

    .hero__caption {
      display: none;
    }

    .hero__foot {
      flex-wrap: wrap;
      gap: var(--s-3) var(--s-5);
    }

    .hero__scroll {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .hero__eyebrow {
      margin-bottom: var(--s-4);
    }

    .hero__title {
      margin-bottom: var(--s-4);
    }

    .hero__lede {
      margin-bottom: var(--s-4);
    }

    .hero__actions {
      gap: var(--s-2);
    }

    .hero__actions .btn {
      flex: 1 1 100%;
    }

  }

  /* Stroke-only type is illegible this small; fall back to solid */
  @media (max-width: 520px) {
    .hero__title em {
      color: var(--c-text-2);
      -webkit-text-stroke: 0;
      text-shadow: none;
    }
  }
</style>
