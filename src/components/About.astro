---
import { about, sections, stats } from "../data/site";
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="container about__grid">
    <header class="about__aside">
      <p class="eyebrow"><b>{sections.about.n}</b> {sections.about.label}</p>
    </header>

    <div class="about__main">
      <h2 class="about__title" id="about-title" data-reveal>
        {about.title} <span>{about.highlight}</span>.
      </h2>

      <div class="about__body" data-reveal>
        <p class="about__lead">{about.lead}</p>
        <p>{about.body}</p>
      </div>

      <dl class="stats" data-reveal>
        {stats.map((s) => (
          <div class="stat">
            <dt class="stat__label mono">{s.label}</dt>
            <dd class="stat__value">
              {s.value.replace(/\+$/, "")}
              {s.value.endsWith("+") && <span class="stat__plus">+</span>}
            </dd>
          </div>
        ))}
      </dl>

      <dl class="ledger" data-reveal>
        {about.facts.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd>
              {f.value}
              {f.note && <span>{f.note}</span>}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .about {
    border-top: 1px solid var(--c-border);
  }

  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: var(--s-5);
  }

  .about__aside .eyebrow {
    position: sticky;
    top: calc(var(--nav-h) + var(--s-5));
  }

  .about__title {
    font-size: var(--t-2xl);
    max-width: 20ch;
    margin-bottom: var(--s-6);
  }

  .about__title span {
    background: var(--g-signal);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .about__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--s-6);
    color: var(--c-text-2);
    margin-bottom: var(--s-7);
  }

  .about__body p {
    max-width: 70ch;
  }

  .about__lead {
    color: var(--c-text);
    font-size: var(--t-md);
    line-height: 1.55;
  }

  /* ---------- Stats: evidence, not adjectives ---------- */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-5);
    margin-bottom: var(--s-6);
  }

  /* Label is first in the DOM for screen readers ("Years… 2+"); the number leads visually */
  .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: var(--s-2);
    padding-top: var(--s-4);
    border-top: 1px solid var(--c-border-strong);
  }

  .stat__value {
    font-family: var(--f-display);
    font-size: var(--t-xl);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--c-text);
  }

  .stat__plus {
    color: var(--c-rose);
  }

  .stat__label {
    color: var(--c-text-3);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1.5;
  }

  /* ---------- Facts ---------- */
  .ledger {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0 var(--s-5);
  }

  .ledger div {
    display: grid;
    align-content: start;
    gap: var(--s-2);
    padding-block: var(--s-4);
    border-top: 1px solid var(--c-border);
  }

  .ledger dt {
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-text-3);
  }

  .ledger dd {
    font-weight: 500;
  }

  .ledger dd span {
    display: block;
    font-weight: 400;
    font-size: var(--t-sm);
    color: var(--c-text-2);
  }

  @media (max-width: 1099px) {
    .ledger {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 859px) {
    .about__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .about__aside .eyebrow {
      position: static;
    }

    .about__body {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-4);
      margin-bottom: var(--s-6);
    }

    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--s-4);
    }
  }

  @media (max-width: 480px) {
    .ledger {
      grid-template-columns: minmax(0, 1fr);
    }

    .ledger div {
      grid-template-columns: 7.5rem minmax(0, 1fr);
      gap: var(--s-3);
    }
  }
</style>
