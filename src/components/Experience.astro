---
import { Picture } from "astro:assets";
import { experience, sections } from "../data/site";

const copy = sections.experience;
---

<section class="section xp" id="experience" aria-labelledby="xp-title">
  <div class="container">
    <header class="section-head section-head--compact">
      <p class="eyebrow"><b>{copy.n}</b> {copy.label}</p>
      <h2 id="xp-title" data-reveal>{copy.title}</h2>
      <p data-reveal>{copy.intro}</p>
    </header>

    <ol class="timeline" role="list">
      {experience.map((r, i) => (
        <li class:list={["role", { "role--current": r.current }]} data-reveal style={`--reveal-i:${i % 2}`}>
          <div class="role__when">
            <p class="role__dates mono">
              <time>{r.start}</time> <span aria-hidden="true">–</span> <time>{r.end}</time>
            </p>
            <p class="role__where">{r.where}</p>
            {r.current && <p class="role__badge mono">Current</p>}
          </div>

          <div class="role__body">
            <span class="role__node" aria-hidden="true"></span>
            <h3 class="role__company">{r.company}</h3>
            <p class="role__title">
              {r.title} <span class="role__stack mono">{r.stack}</span>
            </p>

            <ul class="role__points" role="list">
              {r.points.map((p) => <li>{p}</li>)}
            </ul>

            {r.delivered && (
              <div class="delivered">
                <p class="delivered__label mono">{r.delivered.label}</p>
                <ul class="clients" role="list">
                  {r.delivered.items.map((c, n) => {
                    const Tag = c.href ? "a" : "div";
                    return (
                      <li>
                        <Tag
                          class:list={["client", { "client--link": c.href }]}
                          {...(c.href ? { href: c.href, target: "_blank", rel: "noopener noreferrer" } : {})}
                        >
                          <div class:list={["client__media", { "client__media--empty": !c.image && !c.logo }]}>
                            {c.image ? (
                              <Picture
                                src={c.image}
                                alt={`Screenshot of the ${c.name} website`}
                                formats={["avif", "webp"]}
                                widths={[240, 360, 480]}
                                sizes="(min-width: 1100px) 170px, (min-width: 860px) 28vw, 45vw"
                                loading="lazy"
                              />
                            ) : c.logo ? (
                              <Picture class="client__logo" src={c.logo} alt={`${c.name} logo`} widths={[160, 240]} sizes="120px" loading="lazy" />
                            ) : (
                              <span class="client__placeholder mono" aria-hidden="true">{c.name}</span>
                            )}
                          </div>
                          <p class="client__name">
                            <span class="client__n mono">{String(n + 1).padStart(2, "0")}</span>
                            {c.name}
                            {c.href && <span class="visually-hidden"> (opens in a new tab)</span>}
                          </p>
                          {c.note && <p class="client__note">{c.note}</p>}
                        </Tag>
                      </li>
                    );
                  })}
                </ul>
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .xp {
    border-top: 1px solid var(--c-border);
  }

  .timeline {
    border-top: 1px solid var(--c-border);
  }

  .role {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: var(--s-5);
    padding-block: var(--s-7);
    border-bottom: 1px solid var(--c-border);
  }

  /* ---------- Left rail: dates & place ---------- */
  .role__when {
    display: grid;
    align-content: start;
    gap: var(--s-2);
  }

  .role__dates {
    color: var(--c-text-2);
    font-size: var(--t-sm);
  }

  .role__where {
    font-size: var(--t-sm);
    color: var(--c-text-3);
  }

  .role__badge {
    justify-self: start;
    margin-top: var(--s-2);
    padding: 3px 8px;
    border: 1px solid var(--c-blue-line);
    border-radius: var(--r-xs);
    background: var(--c-blue-soft);
    color: var(--c-blue);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* ---------- Body ---------- */
  .role__body {
    position: relative;
    padding-left: var(--s-6);
    border-left: 1px solid var(--c-border);
  }

  .role__node {
    position: absolute;
    left: -5px;
    top: 0.55em;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--c-bg);
    border: 1px solid var(--c-text-3);
    transition:
      background-color var(--d-base),
      border-color var(--d-base);
  }

  .role--current .role__node {
    background: var(--c-blue);
    border-color: var(--c-blue);
    box-shadow: 0 0 0 4px var(--c-blue-soft);
  }

  .role:hover .role__node {
    border-color: var(--c-blue);
  }

  .role__company {
    font-size: var(--t-xl);
    font-weight: 500;
    letter-spacing: -0.03em;
    margin-bottom: var(--s-2);
  }

  .role__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2) var(--s-3);
    color: var(--c-text);
    font-weight: 500;
    margin-bottom: var(--s-5);
  }

  .role__stack {
    color: var(--c-text-3);
  }

  .role__points {
    display: grid;
    gap: var(--s-2);
    max-width: 70ch;
    color: var(--c-text-2);
  }

  .role__points li {
    position: relative;
    padding-left: 1.25em;
  }

  .role__points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.8em;
    width: 0.6em;
    height: 1px;
    background: var(--c-blue);
  }

  /* ---------- Named deliverables ---------- */
  .delivered {
    margin-top: var(--s-6);
    padding: var(--s-5);
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    background:
      linear-gradient(135deg, var(--c-blue-soft), transparent 45%),
      var(--c-surface-1);
  }

  .delivered__label {
    color: var(--c-text-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--s-4);
  }

  /* ---------- Client cards ---------- */
  .clients {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--s-4);
  }

  .client {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    height: 100%;
  }

  .client__media {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    margin-bottom: var(--s-2);
    overflow: hidden;
    border: 1px solid var(--c-border);
    border-radius: var(--r-sm);
    background:
      linear-gradient(to right, var(--c-grid-line) 1px, transparent 1px) 0 0 / 16px 16px,
      linear-gradient(to bottom, var(--c-grid-line) 1px, transparent 1px) 0 0 / 16px 16px,
      var(--c-surface-2);
    transition: border-color var(--d-base) var(--ease-out);
  }

  .client__media :global(picture),
  .client__media :global(img) {
    width: 100%;
    height: 100%;
  }

  .client__media :global(img) {
    object-fit: cover;
    object-position: center top;
  }

  .client__media :global(.client__logo),
  .client__media :global(.client__logo img) {
    width: 60%;
    height: auto;
    object-fit: contain;
  }

  .client__placeholder {
    padding: var(--s-2);
    text-align: center;
    color: var(--c-text-3);
    font-size: 0.68rem;
    line-height: 1.4;
    letter-spacing: 0.02em;
  }

  .client__name {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    font-family: var(--f-display);
    font-size: var(--t-sm);
    font-weight: 500;
    line-height: 1.3;
    color: var(--c-text);
  }

  .client__n {
    flex: none;
    color: var(--c-blue);
    font-size: 0.66rem;
  }

  .client__note {
    font-size: var(--t-xs);
    line-height: 1.45;
    color: var(--c-text-3);
  }

  .client--link:hover .client__media {
    border-color: var(--c-blue-line);
  }

  @media (max-width: 1099px) {
    .clients {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 859px) {
    .role {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-4);
      padding-block: var(--s-6);
    }

    .role__when {
      grid-auto-flow: column;
      justify-content: start;
      align-items: center;
      gap: var(--s-2) var(--s-4);
      flex-wrap: wrap;
    }

    .role__badge {
      margin-top: 0;
    }

    .role__body {
      padding-left: var(--s-5);
    }
  }

  @media (max-width: 480px) {
    .role__when {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--s-1) var(--s-3);
    }

    .role__badge {
      order: -1;
    }

    /* The placeholder only repeats the name printed below it */
    .client__media--empty {
      display: none;
    }

    .delivered {
      padding: var(--s-4);
    }

    .clients {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--s-4) var(--s-3);
    }
  }
</style>
