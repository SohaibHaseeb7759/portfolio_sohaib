---
import { Picture } from "astro:assets";
import type { Project } from "../data/site";

interface Props {
  project: Project;
  sizes: string;
  ratio?: string;
}

const { project, sizes, ratio = "16 / 10" } = Astro.props;
const address = (project.live ?? project.repo ?? "").replace(/^https?:\/\//, "").replace(/\/$/, "");
const isPhone = project.device === "phone";
---

{isPhone ? (
  <div class="frame frame--stage" style="--ratio:10 / 9">
    <span class="stage__label mono" aria-hidden="true">{address} · mobile</span>
    <div class="frame__view stage__view">
      <div class="phone">
        <Picture
          src={project.image}
          alt={project.imageAlt}
          formats={["avif", "webp"]}
          widths={[320, 480, 640, project.image.width].filter((w, i, a) => w <= project.image.width && a.indexOf(w) === i)}
          sizes="(min-width: 860px) 300px, 60vw"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
) : (
  <div class="frame" style={`--ratio:${ratio}`}>
    <div class="frame__bar" aria-hidden="true">
      <span class="frame__dots"><i></i><i></i><i></i></span>
      <span class="frame__url mono">{address}</span>
    </div>
    <div class="frame__view">
      <Picture
        src={project.image}
        alt={project.imageAlt}
        formats={["avif", "webp"]}
        widths={[480, 800, 1200, 1600].filter((w) => w <= project.image.width)}
        sizes={sizes}
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
)}

<style>
  .frame {
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    background: var(--c-surface-1);
    box-shadow: var(--shadow-2);
    overflow: hidden;
    transition:
      border-color var(--d-base) var(--ease-out),
      transform var(--d-slow) var(--ease-out);
  }

  .frame__bar {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    height: 34px;
    padding-inline: var(--s-4);
    border-bottom: 1px solid var(--c-border);
    background: var(--c-surface-2);
  }

  .frame__dots {
    display: flex;
    gap: 6px;
    flex: none;
  }

  .frame__dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c-border-strong);
  }

  .frame__url {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--c-text-3);
    font-size: 0.7rem;
    text-align: center;
    padding-right: 42px;
  }

  /* Fixed aspect ratio keeps layout stable regardless of screenshot size */
  .frame__view {
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background:
      repeating-linear-gradient(135deg, transparent 0 10px, rgb(255 255 255 / 0.02) 10px 11px),
      var(--c-surface-1);
  }

  .frame__view :global(picture) {
    height: 100%;
  }

  .frame__view :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition:
      transform 1.2s var(--ease-out),
      filter var(--d-slow) var(--ease-out);
    filter: saturate(0.9) brightness(0.92);
  }

  :global(.project:hover) .frame {
    border-color: var(--c-border-strong);
  }

  :global(.project:hover) .frame__view :global(img) {
    transform: scale(1.03);
    filter: none;
  }

  /* ---------- Phone stage: portrait screenshots on a lit backdrop ---------- */
  .frame--stage {
    position: relative;
  }

  .stage__view {
    position: relative;
    background:
      radial-gradient(60% 75% at 50% 30%, rgb(0 127 255 / 0.2), transparent 70%),
      linear-gradient(to right, rgb(255 255 255 / 0.035) 1px, transparent 1px) 0 0 / 40px 40px,
      linear-gradient(to bottom, rgb(255 255 255 / 0.035) 1px, transparent 1px) 0 0 / 40px 40px,
      var(--c-surface-1);
  }

  .stage__label {
    position: absolute;
    z-index: 1;
    top: var(--s-4);
    left: var(--s-4);
    color: var(--c-text-3);
    font-size: 0.7rem;
  }

  .phone {
    position: absolute;
    top: 10%;
    left: 50%;
    width: min(42%, 300px);
    transform: translateX(-50%);
    padding: 7px;
    border-radius: 34px;
    background: #1b212b;
    box-shadow:
      0 0 0 1px var(--c-border-strong),
      0 40px 80px -20px rgb(0 0 0 / 0.8),
      0 0 60px -10px rgb(0 127 255 / 0.25);
    transition: transform var(--d-slow) var(--ease-out);
  }

  .phone :global(picture) {
    height: auto;
  }

  .stage__view .phone :global(img) {
    height: auto;
    border-radius: 27px;
    object-fit: contain;
    filter: none;
  }

  :global(.project:hover) .phone {
    transform: translateX(-50%) translateY(-8px);
  }

  :global(.project:hover) .stage__view .phone :global(img) {
    transform: none;
  }

  @media (max-width: 520px) {
    .phone {
      width: 46%;
      padding: 5px;
      border-radius: 26px;
    }

    .stage__view .phone :global(img) {
      border-radius: 21px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.project:hover) .phone {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.project:hover) .frame__view :global(img) {
      transform: none;
    }
  }

  @media (max-width: 480px) {
    .frame__url {
      padding-right: 0;
    }
  }
</style>
