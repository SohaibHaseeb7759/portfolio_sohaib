---
import { Picture } from "astro:assets";
import type { Project } from "../data/site";

interface Props {
  project: Project;
  sizes: string;
}

// Phone projects render on the phone stage; anything else in a browser frame
// at the screenshot's own proportions.
const { project, sizes } = Astro.props;
const address = (project.live ?? project.repo ?? "").replace(/^https?:\/\//, "").replace(/\/$/, "");
const isPhone = project.device === "phone";
if (!project.image) throw new Error(`ProjectFrame needs an image for "${project.slug}"`);
const image = project.image;
const second = project.secondaryImage;
const frameRatio = `${image.width} / ${image.height}`;
const phoneWidths = (w: number) => [320, 480, 640, w].filter((x, i, a) => x <= w && a.indexOf(x) === i);
---

{isPhone ? (
  <div class:list={["frame frame--stage", { "has-second": second }]}>
    <span class="stage__label mono" aria-hidden="true">{address} · mobile</span>
    <div class="stage__view">
      {second && (
        <div class="phone phone--back">
          <Picture
            src={second}
            alt={project.secondaryAlt ?? ""}
            formats={["avif", "webp"]}
            widths={phoneWidths(second.width)}
            sizes="(min-width: 1100px) 240px, (min-width: 860px) 20vw, 34vw"
            loading="lazy"
            decoding="async"
          />
        </div>
      )}
      <div class="phone phone--front">
        <Picture
          src={image}
          alt={project.imageAlt ?? ""}
          formats={["avif", "webp"]}
          widths={phoneWidths(image.width)}
          sizes="(min-width: 1100px) 320px, (min-width: 860px) 26vw, 46vw"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
) : (
  <div class="frame" style={`--ratio:${frameRatio}`}>
    <div class="frame__bar" aria-hidden="true">
      <span class="frame__dots"><i></i><i></i><i></i></span>
      <span class="frame__url mono">{address}</span>
    </div>
    <div class="frame__view">
      <Picture
        src={image}
        alt={project.imageAlt ?? ""}
        formats={["avif", "webp"]}
        widths={[480, 800, 1200, 1600].filter((w) => w <= image.width)}
        sizes={sizes}
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
)}

<style>
  .frame {
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    background: var(--c-surface-1);
    box-shadow: var(--shadow-2);
    overflow: hidden;
    transition: border-color var(--d-base) var(--ease-out);
  }

  .frame__bar {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    height: 34px;
    padding-inline: var(--s-4);
    border-bottom: 1px solid var(--c-border);
    background: var(--c-surface-2);
  }

  .frame__dots {
    display: flex;
    gap: 6px;
    flex: none;
  }

  .frame__dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c-border-strong);
  }

  .frame__url {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--c-text-3);
    font-size: 0.7rem;
    text-align: center;
    padding-right: 42px;
  }

  /* Aspect ratio is reserved up front, so the layout never shifts as images load */
  .frame__view {
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background:
      repeating-linear-gradient(135deg, transparent 0 10px, var(--c-hairline) 10px 11px),
      var(--c-surface-1);
  }

  .frame__view :global(picture) {
    height: 100%;
  }

  .frame__view :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition:
      transform 1.2s var(--ease-out),
      filter var(--d-slow) var(--ease-out);
    filter: saturate(0.9) brightness(0.92);
  }

  :global(.project:hover) .frame__view :global(img) {
    filter: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.project:hover) .frame__view :global(img) {
      transform: scale(1.02);
    }
  }

  /* ---------- Phone stage: portrait screenshots on a lit backdrop ---------- */
  .frame--stage {
    position: relative;
  }

  .stage__view {
    position: relative;
    aspect-ratio: 10 / 9;
    overflow: hidden;
    background:
      radial-gradient(60% 75% at 55% 30%, var(--c-blue-glow), transparent 70%),
      linear-gradient(to right, var(--c-grid-line) 1px, transparent 1px) 0 0 / 40px 40px,
      linear-gradient(to bottom, var(--c-grid-line) 1px, transparent 1px) 0 0 / 40px 40px,
      var(--c-surface-1);
  }

  .stage__label {
    position: absolute;
    z-index: 2;
    top: var(--s-4);
    left: var(--s-4);
    color: var(--c-text-3);
    font-size: 0.7rem;
  }

  .phone {
    position: absolute;
    top: 9%;
    left: 50%;
    width: min(44%, 320px);
    transform: translateX(-50%);
    padding: 7px;
    border-radius: 34px;
    background: var(--c-bezel);
    box-shadow:
      0 0 0 1px var(--c-border-strong),
      0 40px 80px -20px var(--c-shadow-deep),
      0 0 60px -10px var(--c-blue-glow);
    transition: transform var(--d-slow) var(--ease-out);
  }

  .phone :global(picture) {
    height: auto;
  }

  .phone :global(img) {
    width: 100%;
    height: auto;
    border-radius: 27px;
  }

  /* Two phones: the second screen sits behind, lower and to the left */
  .has-second .phone--front {
    left: 60%;
  }

  .phone--back {
    z-index: 0;
    top: 19%;
    left: 31%;
    width: min(36%, 260px);
    filter: brightness(0.72) saturate(0.85);
  }

  .phone--front {
    z-index: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.project:hover) .phone--front {
      transform: translateX(-50%) translateY(-8px);
    }

    :global(.project:hover) .phone--back {
      transform: translateX(-50%) translateY(-4px);
    }
  }

  @media (max-width: 520px) {
    .phone {
      padding: 5px;
      border-radius: 24px;
    }

    .phone :global(img) {
      border-radius: 19px;
    }

    .phone--front {
      width: 50%;
    }

    .phone--back {
      width: 40%;
      left: 28%;
    }

    .has-second .phone--front {
      left: 62%;
    }
  }

  @media (max-width: 480px) {
    .frame__url {
      padding-right: 0;
    }
  }
</style>
